  "author": {
    "name": "Oleg Kalistratov",
    "url": "https://github.com/oleg-kalistratov"
  },
  "homepage": "https://github.com/oleg-kalistratov/swift-code-index",
  "repository": "https://github.com/oleg-kalistratov/swift-code-index",
  "license": "MIT",
  "keywords": ["swift", "objective-c", "xcode", "ios", "mcp", "code-navigation", "index-store"],
  "mcpServers": {
    "swift-code-index": {
      "command": "${CLAUDE_PLUGIN_ROOT}/plugin/launch.sh",
      "args": ["${CLAUDE_PROJECT_DIR}"]
    }
  }
}
